# Keep this repository limited to the database and prototype.
/*
!/.gitignore
!/README.md
!/database/
!/prototype/

# Installed dependencies and generated files
**/vendor/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/evidence/
**/*.log
**/.DS_Store
**/Thumbs.db

# Local credentials and configuration
**/.env
**/.env.*
!**/.env.example
**/.pgpass
**/pgpass.conf
**/*.pem
**/*.key
